# Copy to .env for local testing (do NOT commit .env to git)
# On Railway, set these in the Variables tab of your service.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram webhook secret (random hex; setWebhook with this exact value)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=your_webhook_secret_here

# Where on the volume to read/write the SQLite DB
BATYAM_DB_PATH=/data/batyam_data.db

# Shared secret between SiteGround scraper and Railway /sync_db endpoint.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SYNC_SECRET=your_sync_secret_here

# JSON array of chat IDs with admin privileges (for /stats, /add, etc.)
# Get yours by messaging @userinfobot on Telegram.
ADMIN_CHAT_IDS=[YOUR_TELEGRAM_CHAT_ID]

# URL of the public dashboard (used in bot messages as links)
DASHBOARD_URL=https://batyamtoday.meravtech.com/
